/**
 * Dedicated S3 bucket for eval sweep artefacts, read only through a presigned GET. It is not a
 * CloudFront origin.
 *
 * The writer role gets `s3:PutObject` and `s3:GetObject` on one prefix and no `s3:ListBucket`, so
 * it can address only keys it already knows. The bucket policy denies object reads, lists and writes
 * outside `data_plane_principal_arns`, and bucket administration outside
 * `administrator_principal_arns`.
 */

# The bucket's name and ARN are derived from inputs rather than read from `aws_s3_bucket.this`, so
# the policy documents below render at plan time.
locals {
  bucket_name = "${var.name_prefix}-eval-artifacts-${var.account_id}"
  bucket_arn  = "arn:${data.aws_partition.current.partition}:s3:::${local.bucket_name}"
}

data "aws_partition" "current" {}

resource "aws_s3_bucket" "this" {
  # checkov:skip=CKV_AWS_144: contents are regenerated by a sweep or a deploy, so no replica
  # checkov:skip=CKV2_AWS_62: no consumer reacts to object events; reads are presigned GETs
  bucket = local.bucket_name

  # Artefacts are reproducible from a sweep with the same arguments and `dataset_seed`, and expire
  # under the lifecycle rule below. Classified `required` in `check_plan_security_baseline.py`'s
  # BUCKET_TEARDOWN_DISPOSITION.
  force_destroy = true

  tags = {
    "data-classification" = var.data_classification
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "this" {
  bucket = aws_s3_bucket.this.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm     = "aws:kms"
      kms_master_key_id = var.kms_key_arn
    }
    bucket_key_enabled = true
  }
}

resource "aws_s3_bucket_public_access_block" "this" {
  bucket = aws_s3_bucket.this.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_versioning" "this" {
  bucket = aws_s3_bucket.this.id

  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_ownership_controls" "this" {
  bucket = aws_s3_bucket.this.id

  rule {
    object_ownership = "BucketOwnerEnforced"
  }
}

resource "aws_s3_bucket_logging" "this" {
  bucket = aws_s3_bucket.this.id

  target_bucket = var.access_log_bucket_id
  target_prefix = "s3-access-logs/eval-artifacts/"
}

# Expiry covers noncurrent versions and incomplete uploads as well as current objects.
resource "aws_s3_bucket_lifecycle_configuration" "this" {
  bucket = aws_s3_bucket.this.id

  rule {
    id     = "expire-artifacts"
    status = "Enabled"

    # Scoped to `artifact_prefix`: the bucket also holds the CodeBuild agent-source archive, outside
    # that prefix.
    filter {
      prefix = "${var.artifact_prefix}/"
    }

    expiration {
      days = var.artifact_retention_days
    }

    noncurrent_version_expiration {
      noncurrent_days = var.artifact_retention_days
    }

    abort_incomplete_multipart_upload {
      days_after_initiation = 7
    }
  }

  # Whole-bucket, so keys outside `artifact_prefix` (the agent-source archive) are covered too. No
  # current-version `expiration`: the agent-source archive must persist.
  rule {
    id     = "expire-noncurrent-and-abort-uploads"
    status = "Enabled"

    filter {}

    noncurrent_version_expiration {
      noncurrent_days = var.artifact_retention_days
    }

    abort_incomplete_multipart_upload {
      days_after_initiation = 7
    }
  }
}

resource "aws_s3_bucket_policy" "this" {
  bucket = aws_s3_bucket.this.id
  policy = data.aws_iam_policy_document.bucket.json

  lifecycle {
    precondition {
      condition     = contains(var.administrator_principal_arns, var.caller_principal_arn) && var.caller_principal_arn != "arn:aws:iam::${var.account_id}:root"
      error_message = "The caller running this plan is not an operator. Add its role or user ARN to crm_operator_principal_arns in terraform.tfvars, or run as a listed operator; nothing was applied."
    }
  }
}

data "aws_iam_policy_document" "bucket" {
  # `Principal: "*"` inside a DENY enforces TLS for every caller.
  statement {
    sid    = "DenyInsecureTransport"
    effect = "Deny"

    principals {
      type        = "AWS"
      identifiers = ["*"]
    }

    actions   = ["s3:*"]
    resources = [local.bucket_arn, "${local.bucket_arn}/*"]

    condition {
      test     = "Bool"
      variable = "aws:SecureTransport"
      values   = ["false"]
    }
  }

  # This document allows nothing; access is granted by identity policy alone.
  statement {
    sid    = "DenyUnencryptedObjectUploads"
    effect = "Deny"

    principals {
      type        = "AWS"
      identifiers = ["*"]
    }

    actions   = ["s3:PutObject"]
    resources = ["${local.bucket_arn}/*"]

    condition {
      test     = "StringNotEquals"
      variable = "s3:x-amz-server-side-encryption"
      values   = ["aws:kms"]
    }
  }

  statement {
    sid    = "DenyObjectDataPlaneToNonProjectPrincipals"
    effect = "Deny"

    principals {
      type        = "*"
      identifiers = ["*"]
    }

    actions = [
      "s3:GetObject",
      "s3:GetObjectVersion",
      "s3:GetObjectAttributes",
      "s3:GetObjectVersionAttributes",
      "s3:GetObjectTagging",
      "s3:GetObjectVersionTagging",
      "s3:RestoreObject",
      "s3:ListBucket",
      "s3:ListBucketVersions",
      "s3:ListBucketMultipartUploads",
      "s3:ListMultipartUploadParts",
      "s3:PutObject",
      "s3:PutObjectTagging",
      "s3:DeleteObject",
      "s3:DeleteObjectVersion",
      "s3:DeleteObjectTagging",
      "s3:AbortMultipartUpload",
      "s3:PutObjectVersionTagging",
      "s3:DeleteObjectVersionTagging",
    ]
    resources = [local.bucket_arn, "${local.bucket_arn}/*"]

    condition {
      test     = "ArnNotEquals"
      variable = "aws:PrincipalArn"
      values   = var.data_plane_principal_arns
    }
  }

  statement {
    sid    = "DenyBucketAdministrationToNonOperators"
    effect = "Deny"

    principals {
      type        = "*"
      identifiers = ["*"]
    }

    actions = [
      "s3:DeleteBucket",
      "s3:PutBucketPolicy",
      "s3:DeleteBucketPolicy",
      "s3:PutBucketVersioning",
      "s3:PutEncryptionConfiguration",
      "s3:PutLifecycleConfiguration",
      "s3:PutBucketLogging",
      "s3:PutBucketPublicAccessBlock",
      "s3:PutBucketOwnershipControls",
      "s3:PutBucketAcl",
      "s3:PutBucketTagging",
      "s3:PutReplicationConfiguration",
      "s3:PutInventoryConfiguration",
      "s3:PutBucketNotification",
      "s3:PutBucketObjectLockConfiguration",
      "s3:PutBucketRequestPayment",
      "s3:PutBucketWebsite",
      "s3:PutBucketCORS",
      "s3:PutAccelerateConfiguration",
      "s3:PutIntelligentTieringConfiguration",
      "s3:PutAnalyticsConfiguration",
      "s3:PutMetricsConfiguration",
    ]
    resources = [local.bucket_arn]

    condition {
      test     = "ArnNotEquals"
      variable = "aws:PrincipalArn"
      values   = var.administrator_principal_arns
    }
  }
}

# --- Writer grant ------------------------------------------------------------
# Attached to the sweep worker's role. No `s3:ListBucket`.
resource "aws_iam_role_policy" "writer" {
  count = var.writer_role_name == null ? 0 : 1

  name = "${var.name_prefix}-eval-artifacts-writer"
  role = var.writer_role_name

  policy = data.aws_iam_policy_document.writer.json
}

data "aws_iam_policy_document" "writer" {
  statement {
    sid    = "WriteAndReadArtifactPrefix"
    effect = "Allow"

    actions = ["s3:PutObject", "s3:GetObject"]

    # Object-level only, scoped to the artefact prefix.
    resources = ["${local.bucket_arn}/${var.artifact_prefix}/*"]
  }

  # SSE-KMS PutObject needs `kms:GenerateDataKey` and GetObject needs `kms:Decrypt` on the bucket's CMK.
  statement {
    sid    = "UseBucketCmk"
    effect = "Allow"

    actions   = ["kms:GenerateDataKey", "kms:Decrypt"]
    resources = [var.kms_key_arn]
  }
}
