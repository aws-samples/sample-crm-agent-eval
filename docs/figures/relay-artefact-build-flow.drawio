<mxfile host="drawio" compressed="false"><diagram id="relay-artefact-build-flow" name="Relay build flow"><mxGraphModel dx="1200" dy="760" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="760" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="figure-title" value="CRM Agent Eval — relay build flow and deploy guard" style="html=0;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="-44" width="1160" height="32" as="geometry"/></mxCell>
<mxCell id="builddir" value="infra/build/lambda/ (gitignored, read by Terraform)" style="html=0;rounded=1;arcSize=3;dashed=1;strokeColor=#879196;fillColor=none;fontColor=#545B64;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="720" y="20" width="460" height="268" as="geometry"/></mxCell>
<mxCell id="src" value="src/relay/&#10;TypeScript sources,&#10;package.json, lockfile,&#10;tsconfig files" style="html=0;rounded=1;arcSize=8;fillColor=#F2F3F3;strokeColor=#879196;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="157" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="plambdas" value="scripts/package_lambdas.sh&#10;Python zips; clears the build&#10;directory but keeps relay.zip" style="html=0;rounded=1;arcSize=8;fillColor=#E6F2F8;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="46" width="330" height="64" as="geometry"/></mxCell>
<mxCell id="prelay" value="scripts/package_relay.sh&#10;1. npm ci, then tsc -p tsconfig.build.json&#10;2. stage the output, index.js at the root&#10;3. npm ci --omit=dev (production deps)&#10;4. write .relay-build.json (input SHA-256s)&#10;5. zip -X, sorted entries, fixed mtimes&#10;6. import probe on the built zip" style="html=0;rounded=1;arcSize=6;fillColor=#E6F2F8;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="300" y="126" width="330" height="152" as="geometry"/></mxCell>
<mxCell id="pyzips" value="Python Lambda zips" style="html=0;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="58" width="420" height="40" as="geometry"/></mxCell>
<mxCell id="zip" value="relay.zip (byte-deterministic)&#10;index.js at the archive root&#10;package.json with &quot;type&quot;: &quot;module&quot;&#10;node_modules/ (production only)&#10;.relay-build.json manifest" style="html=0;rounded=1;arcSize=6;fillColor=#E8F5E1;strokeColor=#3F8624;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="130" width="420" height="140" as="geometry"/></mxCell>
<mxCell id="guard" value="scripts/deploy.sh guard, before terraform init" style="html=0;rounded=1;arcSize=3;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="1160" height="290" as="geometry"/></mxCell>
<mxCell id="pycheck" value="check_lambda_zip_imports.py&#10;--require-zips&#10;(the Python zips)" style="html=0;rounded=1;arcSize=8;fillColor=#E6F2F8;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="220" height="80" as="geometry"/></mxCell>
<mxCell id="c1" value="1. check_relay_zip.py&#10;--require-zip --zip relay.zip&#10;manifest vs current SHA-256&#10;of src/relay (currency)" style="html=0;rounded=1;arcSize=8;fillColor=#E6F2F8;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="392" width="270" height="96" as="geometry"/></mxCell>
<mxCell id="c2" value="2. package_relay.sh&#10;--verify-only relay.zip&#10;import index.handler from&#10;the zip (importability)" style="html=0;rounded=1;arcSize=8;fillColor=#E6F2F8;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="392" width="250" height="96" as="geometry"/></mxCell>
<mxCell id="tf" value="terraform init,&#10;then apply" style="html=0;rounded=1;arcSize=8;fillColor=#E8F5E1;strokeColor=#3F8624;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="400" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="pyfail" value="die: Python zips stale&#10;or missing&#10;nothing applied" style="html=0;rounded=1;arcSize=8;fillColor=#FDECEA;strokeColor=#D13212;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="220" height="76" as="geometry"/></mxCell>
<mxCell id="c1fail" value="exit 1: stale, absent, unreadable&#10;exit 3: verified nothing&#10;either way: die, nothing applied" style="html=0;rounded=1;arcSize=8;fillColor=#FDECEA;strokeColor=#D13212;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="540" width="270" height="76" as="geometry"/></mxCell>
<mxCell id="c2fail" value="die: handler cannot be&#10;imported from the zip&#10;nothing applied" style="html=0;rounded=1;arcSize=8;fillColor=#FDECEA;strokeColor=#D13212;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="540" width="250" height="76" as="geometry"/></mxCell>
<mxCell id="note" value="Neither guard rebuilds: run scripts/package_relay.sh, then deploy again.&#10;make verify runs check_relay_zip.py without --require-zip: no zip is [SKIP] (exit 3), never a pass." style="html=0;rounded=1;arcSize=6;dashed=1;strokeColor=#879196;fillColor=none;fontColor=#545B64;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="670" width="1160" height="56" as="geometry"/></mxCell>
