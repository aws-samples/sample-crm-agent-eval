<mxfile host="drawio" compressed="false"><diagram id="runbook-deploy-pipeline" name="Deploy pipeline"><mxGraphModel dx="950" dy="650" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="950" pageHeight="650" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="figure-title" value="CRM Agent Eval — the deploy pipeline" style="html=0;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="-44" width="910" height="32" as="geometry"/></mxCell>
<mxCell id="build" value="1. Build&#10;scripts/package_lambdas.sh&#10;scripts/package_relay.sh&#10;(either order)&#10;→ infra/build/lambda/" style="html=0;rounded=1;arcSize=6;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=4;fontSize=14;fillColor=#E6F2F8;strokeColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="270" height="110" as="geometry"/></mxCell>
<mxCell id="backend" value="2. State backend&#10;(one time per account)&#10;infra/bootstrap_state_backend.sh&#10;→ infra/backend.hcl" style="html=0;rounded=1;arcSize=6;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=4;fontSize=14;fillColor=#E6F2F8;strokeColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="340" y="20" width="270" height="110" as="geometry"/></mxCell>
<mxCell id="tfvars" value="3. infra/terraform.tfvars&#10;adopted VPC, subnet and&#10;route-table ids;&#10;adopted-VPC preflight" style="html=0;rounded=1;arcSize=6;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=4;fontSize=14;fillColor=#E6F2F8;strokeColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="660" y="20" width="270" height="110" as="geometry"/></mxCell>
<mxCell id="deploy" value="4. scripts/deploy.sh&#10;refusals and gates (exposure,&#10;VPC preflight, zip checks)&#10;terraform apply&#10;parity and drift checks&#10;publish the SPA:&#10;npm run build → frontend/dist&#10;s3 sync to the origin bucket&#10;CloudFront invalidation /*&#10;→ results/tf-outputs.json" style="html=0;rounded=1;arcSize=6;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=4;fontSize=14;fillColor=#FFF4E5;strokeColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="270" height="240" as="geometry"/></mxCell>
<mxCell id="first" value="5. First deployment: two applies" style="html=0;rounded=1;arcSize=6;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=4;fontSize=14;fillColor=#FFFFFF;strokeColor=#ED7100;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="210" width="270" height="240" as="geometry"/></mxCell>
<mxCell id="a1" value="Apply 1: deploy.sh with a&#10;placeholder security group" style="html=0;rounded=1;arcSize=6;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=4;fontSize=14;fillColor=#FFF4E5;strokeColor=#ED7100;fontSize=13;" vertex="1" parent="first"><mxGeometry x="15" y="40" width="240" height="52" as="geometry"/></mxCell>
<mxCell id="sg" value="read the id of&#10;CloudFront-VPCOrigins-Service-SG" style="html=0;rounded=1;arcSize=6;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=4;fontSize=14;fillColor=#FFF4E5;strokeColor=#ED7100;fontSize=13;" vertex="1" parent="first"><mxGeometry x="15" y="108" width="240" height="52" as="geometry"/></mxCell>
<mxCell id="a2" value="Apply 2: deploy.sh with that&#10;id; /api/* now reachable" style="html=0;rounded=1;arcSize=6;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=4;fontSize=14;fillColor=#FFF4E5;strokeColor=#ED7100;fontSize=13;" vertex="1" parent="first"><mxGeometry x="15" y="176" width="240" height="52" as="geometry"/></mxCell>
<mxCell id="a1-sg" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="first" source="a1" target="sg"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="sg-a2" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="first" source="sg" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="api" value="6. Post-deploy /api/* check&#10;VPC origin present;&#10;unauthenticated request&#10;→ 401 or 403" style="html=0;rounded=1;arcSize=6;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=4;fontSize=14;fillColor=#E8F5E1;strokeColor=#3F8624;" vertex="1" parent="1"><mxGeometry x="660" y="210" width="270" height="240" as="geometry"/></mxCell>
<mxCell id="ui" value="7. Bring up the UI&#10;seed_demo_tenant.py&#10;provision_demo_user.py&#10;sign in" style="html=0;rounded=1;arcSize=6;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=4;fontSize=14;fillColor=#E8F5E1;strokeColor=#3F8624;" vertex="1" parent="1"><mxGeometry x="20" y="510" width="270" height="160" as="geometry"/></mxCell>
<mxCell id="verify" value="8. Verification layers 4-6&#10;scripts/verify_deployment.sh&#10;--i-understand-this-is-billable" style="html=0;rounded=1;arcSize=6;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=4;fontSize=14;fillColor=#E8F5E1;strokeColor=#3F8624;" vertex="1" parent="1"><mxGeometry x="340" y="510" width="270" height="160" as="geometry"/></mxCell>
<mxCell id="down" value="9. Teardown&#10;reap_eval_tenants.py first&#10;scripts/teardown.sh&#10;(≤5 min ENI wait; re-run if held)&#10;scan_residue.py&#10;remove_state_backend.py&#10;scan_residue.py → exit 0" style="html=0;rounded=1;arcSize=6;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=4;fontSize=14;fillColor=#FDECEA;strokeColor=#D13212;" vertex="1" parent="1"><mxGeometry x="660" y="510" width="270" height="160" as="geometry"/></mxCell>
<mxCell id="e12" value="" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="build" target="backend"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e23" value="" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="tfvars"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e34" value="" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tfvars" target="deploy"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="795" y="160"/><mxPoint x="155" y="160"/></Array></mxGeometry></mxCell>
<mxCell id="e45" value="first&#10;deploy" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="deploy" target="first"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e56" value="" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="first" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e67" value="" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="api" target="ui"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="795" y="480"/><mxPoint x="155" y="480"/></Array></mxGeometry></mxCell>
<mxCell id="e78" value="" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ui" target="verify"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e89" value="" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="verify" target="down"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e46" value="later deploys" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.75;exitY=0;entryX=0.25;entryY=0;" edge="1" parent="1" source="deploy" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="222.5" y="185"/><mxPoint x="727.5" y="185"/></Array></mxGeometry></mxCell>
