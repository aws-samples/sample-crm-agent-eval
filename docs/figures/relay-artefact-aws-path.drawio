<mxCell id="inset" value="Inset: one turn inside the relay" style="html=0;rounded=1;arcSize=2;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="1200" height="340" as="geometry"/></mxCell>
<mxCell id="s1" value="1. Verify Cognito JWT&#10;from X-Crm-Authorization&#10;(before any other check)" style="html=0;rounded=1;arcSize=8;fillColor=#E6F2F8;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="200" height="76" as="geometry"/></mxCell>
<mxCell id="s2" value="2. Check the request&#10;POST, session id,&#10;message body" style="html=0;rounded=1;arcSize=8;fillColor=#E6F2F8;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="760" width="200" height="76" as="geometry"/></mxCell>
<mxCell id="s3" value="3. InvokeAgentRuntime&#10;over SigV4&#10;(no retry)" style="html=0;rounded=1;arcSize=8;fillColor=#E6F2F8;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="520" y="760" width="190" height="76" as="geometry"/></mxCell>
<mxCell id="s4" value="4. HTTP 200 event stream&#10;each complete data: frame&#10;re-emitted verbatim&#10;(unknown kinds too)" style="html=0;rounded=1;arcSize=8;fillColor=#E6F2F8;strokeColor=#147EBA;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="752" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="s5" value="5. finally, on every&#10;exit path: one&#10;relay_turn log line,&#10;then end()" style="html=0;rounded=1;arcSize=8;fillColor=#F2F3F3;strokeColor=#879196;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="752" width="165" height="92" as="geometry"/></mxCell>
