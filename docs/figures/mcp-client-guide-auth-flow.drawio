<mxfile host="drawio" compressed="false"><diagram id="mcp-client-guide-auth-flow" name="Gateway auth flow"><mxGraphModel dx="1100" dy="640" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1130" pageHeight="640" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="figure-title" value="CRM Agent Eval — Gateway request flow" style="html=0;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="-44" width="1090" height="32" as="geometry"/></mxCell>
<mxCell id="lane" value="Token sources" style="html=0;rounded=1;arcSize=4;dashed=0;strokeColor=#879196;fillColor=none;fontColor=#232F3E;fontSize=14;fontStyle=1;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="300" height="320" as="geometry"/></mxCell>
<mxCell id="t_cc" value="client_credentials&#10;mcp app client (machine)&#10;gateway/invoke → Gateway #1&#10;supervisor/chat → Gateway #2" style="html=0;rounded=1;strokeColor=#ED7100;fillColor=#FFF4E5;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="30" width="270" height="90" as="geometry"/></mxCell>
<mxCell id="t_pkce" value="Authorization code + PKCE (S256)&#10;mcp_oauth app client (user)&#10;supervisor/chat → Gateway #2 only&#10;Gateway #1 refuses it: client not&#10;allowed, no gateway/invoke scope" style="html=0;rounded=1;strokeColor=#ED7100;fillColor=#FFF4E5;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="160" width="270" height="130" as="geometry"/></mxCell>
<mxCell id="s1" value="AgentCore Gateway – CUSTOM_JWT authorizer&#10;allowed_clients, allowed_scopes&#10;(custom-claim rules: none configured)" style="html=0;rounded=1;strokeColor=#147EBA;fillColor=#E6F2F8;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="410" y="40" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="s2" value="REQUEST interceptor – 1. re-verify the JWT&#10;against Cognito JWKS: signature, exp, iss,&#10;token_use, client id in the allowed list,&#10;this Gateway's scope" style="html=0;rounded=1;strokeColor=#147EBA;fillColor=#E6F2F8;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="410" y="160" width="340" height="84" as="geometry"/></mxCell>
<mxCell id="s3" value="REQUEST interceptor – 2. rewrite arguments&#10;strip IDENTITY_CHANNEL_KEYS:&#10;_identity, _agent_identity, requestContext&#10;then write the verified _identity" style="html=0;rounded=1;strokeColor=#3F8624;fillColor=#E8F5E1;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="410" y="294" width="340" height="84" as="geometry"/></mxCell>
<mxCell id="s4" value="Action Lambda – decode_identity(event)&#10;gateway channel: reads _identity only" style="html=0;rounded=1;strokeColor=#3F8624;fillColor=#E8F5E1;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="410" y="428" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="s5" value="crm.authz – one scope predicate&#10;require_scope / require_listing_scope /&#10;filter_to_scope" style="html=0;rounded=1;strokeColor=#3F8624;fillColor=#E8F5E1;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="410" y="538" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="r1" value="HTTP 401 / 403&#10;refused at the Gateway" style="html=0;rounded=1;strokeColor=#D13212;fillColor=#FDECEA;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="47" width="270" height="56" as="geometry"/></mxCell>
<mxCell id="p2" value="passes through unmodified&#10;(needs no identity)" style="html=0;rounded=1;dashed=1;strokeColor=#879196;fillColor=#F2F3F3;fontColor=#545B64;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="134" width="270" height="48" as="geometry"/></mxCell>
<mxCell id="r2" value="JSON-RPC error, one fixed message:&#10;&quot;Authentication failed.&#10;Sign in again to continue.&quot;" style="html=0;rounded=1;strokeColor=#D13212;fillColor=#FDECEA;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="191" width="270" height="72" as="geometry"/></mxCell>
<mxCell id="n3" value="custom:rep_id claim → user principal&#10;no custom:rep_id (machine token)&#10;→ service principal svc-mcp-gateway,&#10;book + tenant read from reps" style="html=0;rounded=1;strokeColor=#3F8624;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="294" width="270" height="84" as="geometry"/></mxCell>
<mxCell id="r4" value="authentication_failed&#10;missing or malformed identity,&#10;never a default" style="html=0;rounded=1;strokeColor=#D13212;fillColor=#FDECEA;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="425" width="270" height="66" as="geometry"/></mxCell>
<mxCell id="r5" value="scope_denied: record or account&#10;filter outside the book, or an&#10;empty-book listing (account:*)" style="html=0;rounded=1;strokeColor=#D13212;fillColor=#FDECEA;fontColor=#232F3E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="540" width="270" height="56" as="geometry"/></mxCell>
<mxCell id="e_cc_s1" value="Bearer token" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t_cc" target="s1"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_pkce_s1" value="Bearer token" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.9;" edge="1" parent="1" source="t_pkce" target="s1"><mxGeometry x="0.3" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="365" y="225"/><mxPoint x="365" y="103"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_s1_s2" value="accepted · headers passed" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s1" target="s2"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_s2_s3" value="tools/call · verified" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s2" target="s3"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_s3_s4" value="target invoke · rewritten arguments" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s3" target="s4"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_s4_s5" value="Identity" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s4" target="s5"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_s1_r1" value="client or scope&#10;not allowed" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;dashed=1;strokeColor=#D13212;strokeWidth=1.5;fontSize=12;fontColor=#D13212;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s1" target="r1"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_s2_p2" value="tools/list" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;dashed=1;strokeColor=#879196;strokeWidth=1.5;fontSize=12;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="p2"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_s2_r2" value="verify fails" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;dashed=1;strokeColor=#D13212;strokeWidth=1.5;fontSize=12;fontColor=#D13212;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="r2"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
